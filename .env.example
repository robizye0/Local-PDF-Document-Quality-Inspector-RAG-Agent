# SpecCheck environment configuration
# Copy this file to .env and adjust values as needed.
# Never commit real secrets; use [REDACTED] only in documentation/examples.

# Backend / inference
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
INFERENCE_PROVIDER=ollama
CONFIDENCE_THRESHOLD=0.85
DEMO_MODE=false

# API security and data lifecycle
SPECCHECK_API_KEY=
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_BYTES=26214400
UPLOAD_RETENTION_HOURS=24

# Webhooks (optional)
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_BACKOFF_SECONDS=0.5
WEBHOOK_DEAD_LETTER_PATH=data/webhooks/dead_letter.jsonl

# Async jobs (optional durable deployment)
JOB_BACKEND=thread
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Frontend
API_URL=http://localhost:8000
# Set this to the same value as SPECCHECK_API_KEY when API auth is enabled.
# SPECCHECK_API_KEY=
